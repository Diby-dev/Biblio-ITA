{
  "name": "projet-bibliotheque",
  "version": "1.0.0",
  "description": "Application de gestion de bibliothèque",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "mysql2": "^3.15.3",
    "puppeteer": "^21.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.votreentreprise.gestionbibliotheque",
    "productName": "Biblio ITA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*",
      "!dist/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "buildimg/sidebar.bmp", 
      "installerHeaderIcon": "buildimg/header.bmp" 
    }
  }
}