{
  "name": "projet-bibliotheque",
  "version": "1.0.0",
  "description": "Application de gestion de bibliothèque",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder"
  },
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "mysql2": "^3.15.3",
    "puppeteer": "^21.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.diby.biblioita",
    "productName": "Biblio ITA",
    "publish": {
      "provider": "github",
      "owner": "Diby-dev",
      "repo": "Biblio-ITA"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*",
      "!dist/*"
    ],
    "extraResources": [
      {
        "from": "docum",
        "to": "docum"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "buildimg/sidebar.bmp",
      "installerHeaderIcon": "buildimg/header.bmp"
    }
  }
}